    {
      "parameters": {
        "model": "anthropic/claude-sonnet-4.6",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "ae118cee-dd87-4116-ac94-0bea976a2561",
      "name": "Drafting Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        2400,
        528
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"sections\": [ { \"heading\": \"Section heading\", \"content\": \"Section text\", \"source_ids\": [\"LIB-001\"] } ], \"evidence_gaps\": [\"what evidence is missing for a requirement\"] }"
      },
      "id": "8a4823bd-e3cf-4cc5-9ac1-0821251de781",
      "name": "Draft Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2528,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('Score Fit and Plan').first().json;\nconst raw = $input.first().json;\nconst d = (raw && raw.output && typeof raw.output === 'object') ? raw.output : null;\nconst NL = String.fromCharCode(10);\nconst lib = $('Get Proposal Library').all().map(i => i.json).filter(r => r && r.lib_id);\nconst realIds = {};\nlib.forEach(r => { if (String(r.content || '').indexOf('SAMPLE PLACEHOLDER') === -1) realIds[r.lib_id] = true; });\n\nconst sections = d && Array.isArray(d.sections) ? d.sections : [];\nlet grounded = 0;\nconst parts = [];\nparts.push('# Draft proposal outline: ' + s.title);\nparts.push('> First-pass draft for human review. Statements are only as reliable as the evidence they cite. Nothing here has been submitted.');\nif (s.compressed) parts.push('> Timeline is compressed: fewer than 14 days remain.');\nif (!d) parts.push('> AI drafting was unavailable for this run. Re-run or write manually.');\nsections.forEach(sec => {\n  const ids = (Array.isArray(sec.source_ids) ? sec.source_ids : []).filter(id => realIds[id]);\n  if (ids.length) grounded += 1;\n  parts.push('## ' + String(sec.heading || 'Section'));\n  parts.push(String(sec.content || ''));\n  parts.push(ids.length ? '_Evidence: ' + ids.join(', ') + '_' : '_No supporting evidence in the library. Needs input from the team._');\n});\nconst gaps = d && Array.isArray(d.evidence_gaps) ? d.evidence_gaps.filter(Boolean) : [];\nif (gaps.length) {\n  parts.push('## Evidence gaps to close before submission');\n  gaps.forEach(g => parts.push('- ' + g));\n}\nconst ratio = sections.length ? Math.round((grounded / sections.length) * 100) / 100 : 0;\n\nreturn [{ json: Object.assign({}, s, {\n  draft_markdown: parts.join(NL + NL),\n  grounded_ratio: ratio\n}) }];"
      },
      "id": "5d50c439-7da6-4315-b818-e06dd3b92a9b",
      "name": "Assemble Draft",
