      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst b = j.body || j;\nconst str = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst strip = s => str(s).replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').split(' ').filter(Boolean).join(' ');\nconst title = strip(b.title);\nconst url = str(b.url || b.link);\nconst body = strip(b.text || b.content || b.contentSnippet || b.description);\nif (!title || (!body && !url)) return [];\nconst hint = str(b.deadline).slice(0, 10);\nfunction fnv(s) {\n  let h = 2166136261;\n  for (let i = 0; i < s.length; i++) {\n    h ^= s.charCodeAt(i);\n    h = Math.imul(h, 16777619) >>> 0;\n  }\n  return h.toString(16).padStart(8, '0');\n}\nconst key = (url || title).toLowerCase();\nreturn [{ json: {\n  opp_id: 'OPP-' + fnv(key).toUpperCase(),\n  source: str(b.source) || (j.body ? 'manual' : 'feed'),\n  title: title,\n  url: url,\n  text: (title + '. ' + body).slice(0, 12000),\n  deadline_hint: /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(hint) ? hint : '',\n  received_at: new Date().toISOString()\n} }];"
      },
