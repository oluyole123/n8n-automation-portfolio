    },
    {
      "parameters": {
        "jsonSchemaExample": "{ \"funder\": \"organisation name or empty string\", \"deadline\": \"YYYY-MM-DD or empty string\", \"budget_text\": \"stated budget or empty string\", \"scope_summary\": \"two sentences\", \"eligibility\": [\"each eligibility condition\"], \"mandatory_documents\": [\"each document the applicant must submit\"], \"evaluation_criteria\": [\"each stated scoring criterion\"], \"key_requirements\": [\"each short requirement of the work or programme\"], \"confidence\": 0.8 }"
      },
      "id": "b04f7757-4504-4671-94d8-6f6cfc8aa4e6",
      "name": "Requirements Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1728,
        784
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $('Normalize Opportunity').first().json;\nconst ex0 = $('Extract Requirements').first().json;\nconst ex = (ex0 && ex0.output && typeof ex0.output === 'object') ? ex0.output : null;\nconst prof = $('Get Company Profile').all().map(i => i.json).filter(r => r && r.label);\nconst caps = prof.filter(r => r.kind === 'capability');\nconst NL = String.fromCharCode(10);\nconst DAY = 86400000;\nconst toMs = d => new Date(d + 'T00:00:00Z').getTime();\nconst addDays = (d, n) => new Date(toMs(d) + n * DAY).toISOString().slice(0, 10);\nconst isDate = d => /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(String(d || ''));\nconst today = new Date().toISOString().slice(0, 10);\nconst list = v => Array.isArray(v) ? v.map(x => String(x)).filter(Boolean) : [];\n\nconst deadline = isDate(o.deadline_hint) ? o.deadline_hint : (ex && isDate(ex.deadline) ? ex.deadline : '');\nconst daysLeft = deadline ? Math.round((toMs(deadline) - toMs(today)) / DAY) : null;\n\nconst reqs = ex ? list(ex.key_requirements) : [];\nconst docs = ex ? list(ex.mandatory_documents) : [];\nconst elig = ex ? list(ex.eligibility) : [];\nconst kw = c => String(c.keywords || '').split(',').map(s => s.trim().toLowerCase()).filter(s => s.length >= 3);\nconst fullText = String(o.text || '').toLowerCase();\n\nconst hitCaps = caps.filter(c => kw(c).some(k => fullText.indexOf(k) !== -1));\nconst matchedReq = [];\nconst gapReq = [];\nreqs.forEach(r => {\n  const low = r.toLowerCase();\n  const hit = caps.some(c => kw(c).some(k => low.indexOf(k) !== -1));\n  if (hit) matchedReq.push(r); else gapReq.push(r);\n});\nconst coverage = reqs.length ? matchedReq.length / reqs.length : 0;\nconst capShare = caps.length ? hitCaps.length / caps.length : 0;\nconst fit = Math.round(coverage * 70 + capShare * 30);\n\nlet decision = 'skip';\nif (daysLeft !== null && daysLeft < 0) decision = 'expired';\nelse if (fit >= 50) decision = 'pursue';\nelse if (fit >= 30) decision = 'review';\nconst worth = decision === 'pursue' || decision === 'review';\n\nconst checklist = [];\ndocs.forEach(d => checklist.push({ item: d, type: 'document', status: 'to_prepare' }));\nelig.forEach(e => checklist.push({ item: e, type: 'eligibility', status: 'verify' }));\nmatchedReq.forEach(r => checklist.push({ item: r, type: 'requirement', status: 'covered_by_capability' }));\ngapReq.forEach(r => checklist.push({ item: r, type: 'requirement', status: 'gap' }));\n\nconst tasks = [];\nif (worth) {\n  if (!deadline) {\n    tasks.push({ task: 'Confirm the submission deadline with the funder', due_date: addDays(today, 1) });\n  } else {\n    const clamp = (d, prev) => {\n      let x = d < today ? today : d;\n      if (x > deadline) x = deadline;\n      return x < prev ? prev : x;\n    };\n    const kickoff = clamp(addDays(deadline, -14), today);\n    const draftDone = clamp(addDays(deadline, -7), kickoff);\n    const review = clamp(addDays(deadline, -4), draftDone);\n    const approval = clamp(addDays(deadline, -2), review);\n    const submit = clamp(addDays(deadline, -1), approval);\n    const goNoGo = clamp(addDays(today, 2), today);\n    tasks.push({ task: 'Go/no-go decision, including eligibility check', due_date: goNoGo });\n    tasks.push({ task: 'Kick-off and assign owners', due_date: kickoff });\n    tasks.push({ task: 'Gather mandatory documents (' + docs.length + ' listed)', due_date: draftDone });\n    tasks.push({ task: 'Provide evidence for gaps (' + gapReq.length + ' requirements without matching capability)', due_date: draftDone });\n    tasks.push({ task: 'Complete first full draft', due_date: draftDone });\n    tasks.push({ task: 'Internal review', due_date: review });\n    tasks.push({ task: 'Final approval and sign-off', due_date: approval });\n    tasks.push({ task: 'Submit to the funder', due_date: submit });\n  }\n}\n\nreturn [{ json: {\n  opp_id: o.opp_id,\n  source: o.source,\n  title: o.title,\n  url: o.url,\n  funder: ex ? String(ex.funder || '') : '',\n  deadline: deadline,\n  days_left: daysLeft === null ? 9999 : daysLeft,\n  compressed: daysLeft !== null && daysLeft >= 0 && daysLeft < 14,\n  fit_score: fit,\n  decision: decision,\n  worth: worth,\n  ai_available: !!ex,\n  matched_capabilities: hitCaps.map(c => c.label).join(', '),\n  gaps: gapReq.join(' | '),\n  requirements: JSON.stringify({ scope_summary: ex ? ex.scope_summary : '', budget_text: ex ? ex.budget_text : '', eligibility: elig, mandatory_documents: docs, evaluation_criteria: ex ? list(ex.evaluation_criteria) : [], key_requirements: reqs }),\n  requirements_text: reqs.map(r => '- ' + r).join(NL),\n  profile_text: caps.map(c => '- ' + c.label + ': ' + c.detail).join(NL),\n  checklist: JSON.stringify(checklist),\n  tasks: tasks,\n  status: decision === 'pursue' ? 'draft_ready_for_review' : (decision === 'review' ? 'go_no_go_review' : decision),\n  created_at: new Date().toISOString()\n} }];"
      },
