              "value": "={{ [{\"role\": \"system\", \"content\": \"You are US Law Ripple Engine. You MUST return 3 chain items always, no blanks. Format strictly: {\\\"law\\\":\\\"short title max 10 words\\\", \\\"chain\\\":[{\\\"order\\\":\\\"1st\\\",\\\"effect\\\":\\\"20 words\\\",\\\"who_feels_it\\\":\\\"who\\\"},{\\\"order\\\":\\\"2nd\\\",\\\"effect\\\":\\\"20 words\\\",\\\"who_feels_it\\\":\\\"who\\\"},{\\\"order\\\":\\\"3rd\\\",\\\"effect\\\":\\\"20 words\\\",\\\"who_feels_it\\\":\\\"who\\\"}], \\\"winners_losers\\\":{\\\"winners\\\":[\\\"2 items\\\"],\\\"losers\\\":[\\\"3 items\\\"]}, \\\"citizen_action\\\":\\\"1 sentence\\\", \\\"business_play\\\":\\\"1 sentence\\\"} NEVER leave who_feels_it empty. Return JSON only.\"}, {\"role\": \"user\", \"content\": \"LAW: \" + ($('Parse 1 Law').item.json.law || $json.law)}] }}"
