      "id": "242c0881-f052-41e0-90af-1ba00c213807",
      "name": "OpenRouter - Ripple Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet raw = input.choices?.[0]?.message?.content || input.text || JSON.stringify(input);\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nif (m) raw = m[0];\nlet p;\ntry { p = JSON.parse(raw); }\ncatch { return [{json: {text: `Parser Error:\\n${raw}`.slice(0,4000)}}]; }\n\nfunction clean(s){ return (s||'').replace(/([a-z])([A-Z])/g,'$1 $2').trim(); }\nconst chain = p.chain || [];\nconst c1 = chain[0] || {};\nconst c2 = chain[1] || {};\nconst c3 = chain[2] || {};\n\nconst text = `⚖️ <b>${clean(p.law)}</b>\n\n<b>RIPPLE EFFECT:</b>\n<b>1st (0-30d):</b> ${clean(c1.effect)}\n→ Who: ${clean(c1.who_feels_it)}\n\n<b>2nd (1-6mo):</b> ${clean(c2.effect)}\n→ Who: ${clean(c2.who_feels_it)}\n\n<b>3rd (6-24mo):</b> ${clean(c3.effect)}\n→ Who: ${clean(c3.who_feels_it)}\n\n🏆 Winners: ${(p.winners_losers?.winners||[]).join(', ')}\n💔 Losers: ${(p.winners_losers?.losers||[]).join(', ')}\n\n👨‍💼 DO: ${clean(p.citizen_action)}\n💰 PLAY: ${clean(p.business_play)}`;\n\nreturn [{json: {text}}];\n"
      },
