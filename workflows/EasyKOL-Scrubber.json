      "name": "Convert to File"
    },
    {
      "parameters": {
        "jsCode": "const clean = (v) => String(v ?? '').replace(/\\s+/g, ' ').trim();\nconst emailRe = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/;\nconst urlRe = /https?:\\/\\/[^\\s,;]+/i;\n\nconst seen = new Set();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  const fullName = clean(j['Nickname']);\n  const nameParts = fullName.split(' ');\n  const first_name = nameParts[0] || '';\n  const last_name = nameParts.slice(1).join(' ');\n\n  const description = clean(j['Description']);\n  const ai_tags = clean(j['AI Tags']);\n  const combined = `${description} ${ai_tags}`;\n\n  const email = ((combined.match(emailRe) || [''])[0]).toLowerCase();\n  const profile_url = (combined.match(urlRe) || [''])[0];\n\n  const dedupe_key = (email || fullName).toLowerCase();\n\n  let is_valid = Boolean(fullName) && Boolean(description || ai_tags);\n  if (is_valid && seen.has(dedupe_key)) is_valid = false;\n  if (is_valid) seen.add(dedupe_key);\n\n  results.push({\n    json: {\n      full_name: fullName,\n      first_name,\n      last_name,\n      description,\n      ai_tags,\n      email,\n      profile_url,\n      dedupe_key,\n      is_valid,\n    },\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
