    {
      "id": "ae48edcb-ee71-4be1-8f17-efcca3cfda1e",
      "name": "Score and Route Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const c = $('Normalize Claim').first().json;\nconst polItem = $('Lookup Policy').first();\nconst pol = (polItem && polItem.json) ? polItem.json : {};\nconst aiRaw = $input.first().json;\nconst ai = (aiRaw && aiRaw.output && typeof aiRaw.output === 'object') ? aiRaw.output : null;\n\nconst DAY = 86400000;\nconst toMs = d => new Date(d + 'T00:00:00Z').getTime();\nconst today = new Date().toISOString().slice(0, 10);\nconst amt = c.amount_claimed;\n\nconst policyIssues = [];\nconst found = !!pol.policy_number;\nif (!found) {\n  policyIssues.push('Policy number not found');\n} else {\n  if (String(pol.status).toLowerCase() !== 'active') policyIssues.push('Policy status is ' + pol.status);\n  if (c.incident_date < pol.start_date || c.incident_date > pol.end_date) policyIssues.push('Incident date is outside the policy period (' + pol.start_date + ' to ' + pol.end_date + ')');\n  const covered = String(pol.coverage_types || '').split(',').map(s => s.trim().toLowerCase());\n  if (covered.indexOf(c.claim_type) === -1) policyIssues.push('Claim type ' + c.claim_type + ' is not in the covered types (' + covered.join(', ') + ')');\n}\nconst policyOk = policyIssues.length === 0;\nconst limit = Number(pol.coverage_limit) || 0;\nconst deductible = Number(pol.deductible) || 0;\nconst payableEstimate = policyOk ? Math.min(Math.max(amt - deductible, 0), limit) : 0;\n\nconst REQUIRED = {\n  motor: ['police_report', 'photos', 'repair_estimate'],\n  theft: ['police_report', 'proof_of_ownership'],\n  property: ['photos', 'repair_estimate'],\n  fire: ['fire_service_report', 'photos'],\n  flood: ['photos', 'repair_estimate'],\n  health: ['medical_report', 'invoice']\n};\nconst required = REQUIRED[c.claim_type] || ['supporting_documents'];\nconst provided = c.attachments || [];\nconst missing = required.filter(r => provided.indexOf(r) === -1);\n\nlet cx = 0;\nlet an = 0;\nconst cxWhy = [];\nconst anWhy = [];\nconst addC = (pts, why) => { cx += pts; cxWhy.push(why + ' (+' + pts + ')'); };\nconst addA = (pts, why) => { an += pts; anWhy.push(why + ' (+' + pts + ')'); };\n\nif (amt >= 5000000) addC(35, 'High claim value');\nelse if (amt >= 1000000) addC(20, 'Elevated claim value');\nelse if (amt >= 250000) addC(10, 'Moderate claim value');\n\nif (ai) {\n  if (ai.injuries_reported) addC(20, 'Injuries reported');\n  if (ai.third_party_involved) addC(15, 'Third party involved');\n  const inc = Array.isArray(ai.inconsistencies) ? ai.inconsistencies.filter(Boolean) : [];\n  if (inc.length) addC(Math.min(inc.length * 10, 20), 'Narrative inconsistencies: ' + inc.join('; '));\n  const flags = Array.isArray(ai.red_flags) ? ai.red_flags.filter(Boolean) : [];\n  if (flags.length) addA(Math.min(flags.length * 15, 30), 'Items to verify from narrative: ' + flags.join('; '));\n} else {\n  addC(20, 'AI fact extraction unavailable, manual read required');\n}\nif (missing.length) addC(Math.min(missing.length * 5, 15), 'Missing evidence: ' + missing.join(', '));\nif (found && limit && amt > limit) addC(15, 'Claim exceeds coverage limit');\n\nif (found && pol.start_date) {\n  const days = Math.round((toMs(c.incident_date) - toMs(pol.start_date)) / DAY);\n  if (days >= 0 && days < 30) addA(25, 'Incident ' + days + ' days after policy start');\n}\nif (found && limit && amt >= 0.9 * limit) addA(20, 'Claim is at least 90 percent of the coverage limit');\nif (amt >= 500000 && amt % 100000 === 0) addA(10, 'Round-number claim amount');\nif (found && pol.holder_email && String(pol.holder_email).toLowerCase() !== c.claimant_email) addA(15, 'Claimant email differs from the policyholder email on file');\nif (c.incident_date > today) addA(40, 'Incident date is in the future');\nconst lateDays = Math.round((Date.now() - toMs(c.incident_date)) / DAY);\nif (lateDays > 90) addA(10, 'Reported ' + lateDays + ' days after the incident');\n\ncx = Math.min(cx, 100);\nan = Math.min(an, 100);\n\nlet route = 'fast_track';\nlet priority = 'low';\nif (!policyOk) { route = 'hold_policy_issue'; priority = 'medium'; }\nelse if (an >= 50) { route = 'siu_review'; priority = 'high'; }\nelse if (cx >= 50) { route = 'specialist'; priority = amt >= 5000000 ? 'high' : 'medium'; }\nelse if (missing.length) { route = 'needs_evidence'; priority = 'low'; }\n\nconst statusMap = {\n  fast_track: 'fast_track_pending_approval',\n  needs_evidence: 'awaiting_evidence',\n  specialist: 'specialist_review',\n  siu_review: 'investigation_review',\n  hold_policy_issue: 'on_hold_policy_issue'\n};\n\nconst reasons = policyIssues.concat(cxWhy).concat(anWhy);\nconst summary = 'Claim ' + c.claim_id + ' (' + c.claim_type + ', NGN ' + Number(amt).toLocaleString('en-US') + ') routed to ' + route + '. Complexity ' + cx + ', anomaly ' + an + '.' + (ai && ai.incident_summary ? ' ' + ai.incident_summary : '');\n\nreturn [{ json: {\n  claim_id: c.claim_id,\n  content_hash: c.content_hash,\n  policy_number: c.policy_number,\n  claimant_name: c.claimant_name,\n  claimant_email: c.claimant_email,\n  claim_type: c.claim_type,\n  incident_date: c.incident_date,\n  amount_claimed: amt,\n  narrative: c.narrative,\n  received_at: c.received_at,\n  extracted_facts: JSON.stringify(ai || {}),\n  policy_check: JSON.stringify({ found: found, ok: policyOk, issues: policyIssues, payable_estimate: payableEstimate, coverage_limit: limit, deductible: deductible }),\n  complexity_score: cx,\n  anomaly_score: an,\n  anomaly_reasons: anWhy.join(' | '),\n  route: route,\n  priority: priority,\n  status: statusMap[route],\n  missing_evidence: missing.join(','),\n  missing_evidence_html: '<ul>' + missing.map(m => '<li>' + m.split('_').join(' ') + '</li>').join('') + '</ul>',\n  reasons: reasons.join(' | '),\n  summary: summary\n} }];"
      }
    },
