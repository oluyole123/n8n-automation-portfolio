      "name": "Claim Facts Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1720,
        680
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"incident_summary\": \"one sentence summary\", \"injuries_reported\": false, \"third_party_involved\": false, \"police_report_mentioned\": false, \"location\": \"place named in the narrative or empty string\", \"evidence_mentioned\": [\"photos\"], \"inconsistencies\": [\"short description of any internal contradiction\"], \"red_flags\": [\"short description of any factual red flag stated in the narrative\"], \"confidence\": 0.8 }"
      }
