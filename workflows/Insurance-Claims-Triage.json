    {
      "id": "6f5d64a9-e2c2-4eb0-aa94-81fb35b0ef4b",
      "name": "Normalize Claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body || raw;\nconst str = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst policy = str(b.policy_number).toUpperCase();\nconst email = str(b.claimant_email).toLowerCase();\nconst type = str(b.claim_type).toLowerCase();\nconst incident = str(b.incident_date).slice(0, 10);\nconst amount = Number(str(b.amount_claimed).replace(/[^0-9.]/g, ''));\nconst narrative = str(b.narrative);\nlet attachments = b.attachments;\nif (typeof attachments === 'string') attachments = attachments.split(',');\nattachments = Array.isArray(attachments) ? attachments.map(a => str(a).toLowerCase().split(' ').join('_')).filter(Boolean) : [];\n\nconst errors = [];\nif (!policy) errors.push('policy_number is required');\nif (!email || email.indexOf('@') < 1) errors.push('claimant_email is missing or invalid');\nif (!type) errors.push('claim_type is required');\nif (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(incident)) errors.push('incident_date must be YYYY-MM-DD');\nif (!Number.isFinite(amount) || amount <= 0) errors.push('amount_claimed must be a positive number');\nif (narrative.length < 20) errors.push('narrative must be at least 20 characters');\n\nconst key = [policy, incident, type, amount, email].join('|');\nfunction fnv(s, seed) {\n  let h = seed >>> 0;\n  for (let i = 0; i < s.length; i++) {\n    h ^= s.charCodeAt(i);\n    h = Math.imul(h, 16777619) >>> 0;\n  }\n  return h.toString(16).padStart(8, '0');\n}\nconst hash = fnv(key, 2166136261) + fnv(key.split('').reverse().join(''), (2166136261 ^ 0x9e3779b9) >>> 0);\n\nreturn [{ json: {\n  claim_id: 'CLM-' + hash.slice(0, 8).toUpperCase(),\n  content_hash: hash,\n  policy_number: policy,\n  claimant_name: str(b.claimant_name),\n  claimant_email: email,\n  claim_type: type,\n  incident_date: incident,\n  amount_claimed: amount,\n  narrative: narrative,\n  attachments: attachments,\n  valid: errors.length === 0,\n  validation_errors: errors.join('; '),\n  received_at: new Date().toISOString()\n} }];"
      }
    },
