    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(i => i.json);\n\nconst ENTRY = ['intern', 'entry', 'junior', 'graduate', 'trainee', 'jr ', 'jr.', 'entry-level'];\nconst AUTO = ['ai automation', 'automation', 'n8n', 'low-code', 'low code', 'no-code', 'zapier', 'make.com', 'ai agent', 'ai workflow', 'workflow automation'];\n\nfunction scoreJob(j) {\n  const text = `${j.position || ''} ${j.tags || ''} ${j.company || ''}`.toLowerCase();\n  const isEntry = ENTRY.some(k => text.includes(k));\n  const isAuto = AUTO.some(k => text.includes(k));\n  \n  let score = 0;\n  if (isEntry && isAuto) score = 3; // Majorly wanted\n  else if (isAuto) score = 2;       // Any role in AI Automation\n  else if (isEntry) score = 1;      // Any entry role\n  \n  return { job: j, score, isEntry, isAuto, text };\n}\n\nconst scored = jobs.map(scoreJob).filter(s => s.score > 0);\n\n// Sort by priority: 3 > 2 > 1\nscored.sort((a, b) => b.score - a.score);\n\nreturn scored.slice(0, 20).map(s => {\n  const j = s.job;\n  let type = '';\n  if (s.score === 3) type = 'Entry/Intern - AI Automation [TOP MATCH]';\n  if (s.score === 2) type = 'Any Role - AI Automation';\n  if (s.score === 1) type = 'Entry/Intern - General';\n\n  return {\n    json: {\n      company: j.company,\n      role: j.position,\n      location: (j.location || 'Remote') + ' - Worldwide',\n      url: j.url,\n      source: j.source || j.url,\n      tags: j.tags,\n      code: type,\n      isWorldwide: true,\n      priority: s.score\n    }\n  };\n});"
      },
